# Paper-trading/backtesting defaults (no live broker credentials required)
IT_EXCHANGE=NSE
IT_SYMBOL=RELIANCE
IT_INSTRUMENT_TYPE=EQUITY
IT_TIMEFRAME_MINUTES=5
IT_INITIAL_CAPITAL=1000000

# Risk limits
IT_MAX_DAILY_LOSS_PCT=0.02
IT_MAX_DRAWDOWN_PCT=0.10
IT_PER_TRADE_RISK_PCT=0.005
IT_MAX_POSITION_SIZE=200
IT_MAX_LEVERAGE=1.0
IT_MAX_TRADES_PER_DAY=30
IT_MAX_CONSECUTIVE_LOSSES=4

# Strategy controls
IT_STOP_LOSS_PCT=0.006
IT_TAKE_PROFIT_PCT=0.012
IT_NO_TRADE_VOLATILITY_PCT=0.025
